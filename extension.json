{
	"name": "ScheduledCacheExpiry",
	"version": "1.0.0",
	"author": [
		"Universal Omega"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:ScheduledCacheExpiry",
	"descriptionmsg": "scheduledcacheexpiry-desc",
	"namemsg": "scheduledcacheexpiry-extensionname",
	"license-name": "GPL-3.0-or-later",
	"type": "parserhook",
	"requires": {
		"MediaWiki": ">= 1.46.0"
	},
	"MessagesDirs": {
		"ScheduledCacheExpiry": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"ScheduledCacheExpiryMagic": "ScheduledCacheExpiry.i18n.magic.php"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\ScheduledCacheExpiry\\": "includes/"
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\ScheduledCacheExpiry\\Hooks",
			"services": [
				"ScheduledCacheExpiry.CacheScheduler"
			]
		}
	},
	"Hooks": {
		"ParserFirstCallInit": "main"
	},
	"config": {
		"ScheduledCacheExpiryMinimumExpiry": {
			"value": 60,
			"description": "Floor, in seconds, under which none of the parser functions are allowed to push the cache expiry. Guards against a page setting cacheinterval too low and thrashing the parser cache."
		},
		"ScheduledCacheExpiryTimezone": {
			"value": "UTC",
			"description": "Timezone used when resolving clock times for cacheuntil, for example America/New_York or UTC."
		}
	},
	"manifest_version": 2
}
